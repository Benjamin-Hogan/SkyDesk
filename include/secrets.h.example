// ==========================================================================
//  secrets.h  -  per-device credentials and location
// ==========================================================================
//
//  Copy this file to  include/secrets.h  and fill in real values.
//  secrets.h is gitignored -- NEVER commit real WiFi credentials.
//  No API keys are needed: every data source SkyDesk uses is keyless.
//
#pragma once

// --- WiFi (2.4 GHz only) ---------------------------------------------------
#define WIFI_SSID       "your-wifi-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

// --- OTA (optional; set ENABLE_OTA 1 to allow `pio run -e ota -t upload`) --
#define ENABLE_OTA      0
#define OTA_HOSTNAME    "skydesk"
#define OTA_PASSWORD    "change-me"

// --- Location (optional; defaults to Gilbert, AZ in config.h) --------------
// Uncomment ALL FOUR to override. Elevation is ground height above sea level.
// #define OBS_LAT      33.3528f
// #define OBS_LON      (-111.7890f)
// #define OBS_ELEV_FT  1240.0f
// #define OBS_PLACE    "Gilbert, AZ"
// POSIX TZ string, e.g. "PST8PDT,M3.2.0,M11.1.0" (US Pacific).
// #define NTP_TZ       "MST7"
